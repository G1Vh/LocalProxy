{
  "name": "localproxy",
  "private": true,
  "version": "2.3.2",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:tunnel": "go build -C tunnel -trimpath -ldflags=\"-s -w\" -o ../src-tauri/binaries/localproxy-tunnel-x86_64-pc-windows-msvc.exe .",
    "test:tunnel": "go test -C tunnel ./..."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  }
}
