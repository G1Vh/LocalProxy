{
  "Port": 3128,
  "UpstreamProxy": {
    "Enabled": true,
    "Host": "proxy.example.com",
    "Port": 8080,
    "Username": "user_example",
    "Password": "pass_example"
  },
  "Timeouts": {
    "HttpRequestSeconds": 30,
    "TcpConnectSeconds": 10
  },
  "Domains": [

  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "LocalProxy": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "SingleLine": true
      }
    }
  },
  "AllowedHosts": "*"
}
