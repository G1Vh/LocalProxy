{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalProxy",
  "identifier": "com.g1vh.localproxy",
  "build": {
    "beforeDevCommand": "pnpm build:tunnel && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:tunnel && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalProxy",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "externalBin": [
      "binaries/localproxy-tunnel"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQkEyNjZFN0REMTY5NDAKUldSQWFkRjliaWE2UGRKMXpWQk0rcXh1dmJHN2JDamltMDBVQ1ZTSTV3UVcvRHdmUExPL1ZxTmgK",
      "endpoints": [
        "https://github.com/G1Vh/LocalProxy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
